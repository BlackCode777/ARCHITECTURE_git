<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.tesseracodelabs</groupId>
    <artifactId>biblioteca-microservices</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>biblioteca-microservices</name>
    <description>Fase 2 do estudo Monolito x Microsservicos - sistema de reserva de livros</description>

    <modules>
        <module>api-gateway</module>
        <module>livro-service</module>
        <module>autor-service</module>
        <module>editora-service</module>
        <module>aluguel-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.0</spring-cloud.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>2.8.14</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Cada modulo (api-gateway, *-service) e um projeto Spring Boot gerado no
        start.spring.io. Ao descompactar cada .zip nesta pasta:
          1. remover o proprio <parent> spring-boot-starter-parent do modulo
          2. apontar o <parent> do modulo para este pom:
               <parent>
                 <groupId>com.tesseracodelabs</groupId>
                 <artifactId>biblioteca-microservices</artifactId>
                 <version>0.0.1-SNAPSHOT</version>
               </parent>
          3. remover <groupId>/<version> do modulo (herda deste pom)
          4. remover mvnw/.mvn de cada modulo (usa-se o wrapper desta pasta)
        Dependencias por modulo: ver ../../doc/07-TASKS-MICROSERVICES.md epico 0.
    -->

</project>
